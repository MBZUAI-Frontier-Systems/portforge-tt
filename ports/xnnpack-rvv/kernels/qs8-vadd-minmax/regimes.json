             "b.scale": ["loguniform", 0.001, 200.0], "b.zero_point": ["int", -128, 127],
             "out.scale": ["loguniform", 0.01, 10.0], "out.zero_point": ["int", -128, 127]},
  "accept": "0.0009766 <= a_scale / out_scale < 255 and 0.0009766 <= b_scale / out_scale < 255"
